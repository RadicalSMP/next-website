# ======================
# 数据库
# ======================
DATABASE_URL=postgresql://user:password@localhost:5432/radicalsmp

# 仅供集成测试使用；测试会在此数据库内创建并删除随机临时 schema
TEST_DATABASE_URL=

# ======================
# better-auth
# ======================
# JWT 签名密钥（生产环境必须设置，开发环境自动生成）
# 生成方式: openssl rand -base64 32
BETTER_AUTH_SECRET=

# better-auth 服务端 base URL
BETTER_AUTH_BASE_URL=http://localhost:3000

# 应用 URL（better-auth 客户端 baseURL）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ======================
# GitHub OAuth
# ======================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ======================
# Resend 邮件服务
# ======================
RESEND_API_KEY=

# ======================
# 加密与 OpenAI 回退配置
# ======================
# 生成方式: openssl rand -hex 32
ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# 可选：入服表单种子脚本指定创建者
ADMIN_USER_ID=

# ======================
# CAP 安全验证
# ======================
# 服务端令牌校验地址；可填写服务根地址或以 /api 结尾的地址
CAP_API_URL=https://cap.hami.im/

# 浏览器端组件与挑战接口地址，必须与 CAP_API_URL 指向同一服务
NEXT_PUBLIC_CAP_API_URL=https://cap.hami.im/

# 仅在 next dev 中设为 true 时关闭 CAPTCHA，生产环境始终强制验证
NEXT_PUBLIC_CAPTCHA_DISABLED=false
